# Copy to .env and adjust. Every value has a default, so .env is optional.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production behind HTTPS: DJANGO_HTTPS=true and DJANGO_CSRF_TRUSTED_ORIGINS=https://your.domain
# DJANGO_HTTPS=false
# DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL. Leave unset to use SQLite (db.sqlite3 in the project folder).
# DATABASE_URL=postgres://pricewatch:password@127.0.0.1:5432/pricewatch

# Redis, or a Redis-compatible server such as Memurai on Windows, for Celery.
REDIS_URL=redis://127.0.0.1:6379/0

# Telegram bot token from @BotFather. Without it the bot and price alerts are off.
TELEGRAM_BOT_TOKEN=
# BOT_MAX_SUBSCRIPTIONS=50

# How often a product is re-checked, how often beat looks for due products,
# and how many checks one beat tick may queue.
PRICE_CHECK_INTERVAL_MINUTES=60
PRICE_CHECK_TICK_MINUTES=5
PRICE_CHECK_BATCH_SIZE=200

# Scraper behaviour.
SCRAPER_RESPECT_ROBOTS_TXT=true
SCRAPER_DELAY_SECONDS=2
SCRAPER_RATE_LIMIT=30/m
SCRAPER_TIMEOUT_SECONDS=20
# SCRAPER_USER_AGENT=

# Headless browser. "chrome" uses the installed Google Chrome; leave empty after
# `uv run playwright install chromium`.
# PLAYWRIGHT_CHANNEL=chrome
# PLAYWRIGHT_TIMEOUT_SECONDS=30

# Dashboard is public by default (a read-only demo); true puts it behind the admin login.
# DASHBOARD_LOGIN_REQUIRED=false

# API rate limits.
# API_ANON_RATE=60/min
# API_USER_RATE=600/min

LOG_LEVEL=INFO
